{
  "name": "anxietics",
  "version": "0.3.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "doctor": "npx expo-doctor",
    "export:mobile": "expo export --platform android --output-dir dist/android && expo export --platform ios --output-dir dist/ios",
    "web": "node scripts/prepare-web.cjs && expo start --web",
    "test:preview": "node scripts/verify-preview.cjs && node scripts/verify-lifecycle.cjs",
    "test:3d-preview": "node scripts/verify-3d-scenes.cjs && node scripts/verify-3d-interactions.cjs",
    "dev:games": "node scripts/start-games.cjs",
    "web:games": "node scripts/start-games.cjs --web",
    "test:economy": "node scripts/verify-economy.cjs && node scripts/verify-catalog.cjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-three/fiber": "^9.7.0",
    "@shopify/react-native-skia": "2.6.2",
    "@supabase/supabase-js": "^2.117.1",
    "expo": "^57.0.0",
    "expo-build-properties": "~57.0.21",
    "expo-gl": "~57.0.2",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1",
    "three": "0.182.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "@types/react": "~19.2.4",
    "@types/three": "0.182.0",
    "tsx": "^4.20.5",
    "typescript": "~6.0.3"
  }
}
