{
  "name": "anxietics",
  "version": "0.3.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "doctor": "npx expo-doctor",
    "export:mobile": "expo export --platform android --output-dir dist/android && expo export --platform ios --output-dir dist/ios",
    "web": "node scripts/prepare-web.cjs && expo start --web",
    "test:preview": "node scripts/verify-preview.cjs && node scripts/verify-lifecycle.cjs",
    "dev:games": "node scripts/start-games.cjs",
    "web:games": "node scripts/start-games.cjs --web",
    "test:economy": "node scripts/verify-economy.cjs && node scripts/verify-catalog.cjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/react-native-skia": "2.2.12",
    "expo": "~54.0.0",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "~19.1.10",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2"
  }
}
