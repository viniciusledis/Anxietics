{
  "expo": {
    "name": "Anxietics",
    "slug": "anxietics",
    "version": "0.3.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anxietics.app"
    },
    "android": {
      "package": "com.anxietics.app"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF9F2"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "expo-font"
    ]
  }
}
